# -----------------------------------------------------------------------------
# Supabase (optional locally — without these, the app reads content/ JSON)
# Create a free project at https://supabase.com/dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# Project URL (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key (Settings → API → Project API keys → anon public)
# Safe for the browser; RLS limits it to SELECT on published rows.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key (Settings → API → Project API keys → service_role)
# SERVER / SEED ONLY — never commit, never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Keystatic GitHub storage (optional — only if you enable GitHub mode in
# keystatic.config.ts for production CMS editing)
# -----------------------------------------------------------------------------
# KEYSTATIC_GITHUB_CLIENT_ID=
# KEYSTATIC_GITHUB_CLIENT_SECRET=
# KEYSTATIC_SECRET=
# NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
